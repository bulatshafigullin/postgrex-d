name "postgrex-d"
description "PostgreSQL wire protocol (v3) driver for D, inspired by Elixir's Postgrex. Fiber-aware via vibe-core, works in vibe.d."
authors "bulatshafigullin"
license "MIT"
copyright "Copyright © 2026"
targetType "library"
sourcePaths "source"
importPaths "source"
dependency "vibe-core" version=">=2.0.0"
configuration "library" {
}
// TLS support (sslmode=require / verify-*): needs OpenSSL. Select it from your project with
//   subConfiguration "postgrex-d" "tls"
configuration "tls" {
    dependency "vibe-stream:tls" version=">=1.0.0"
    versions "PostgrexTLS"
}
